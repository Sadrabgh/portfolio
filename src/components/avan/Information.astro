---
import {avanUrl} from '../../lib/avan/paths';
import Intro from './Intro.astro';
import Photo from './Photo.astro';
interface Props {page:string;}
const {page}=Astro.props;
---
{page==='about'&&<><Intro eyebrow="دربارهٔ آوان" title="صدای دلخواهت، انتخاب روشن‌تر." description="باور ما ساده است: انتخاب خوب، از اطلاعات روشن و توجه به زندگی روزمره شروع می‌شود."/><section class="editorial-panel"><div><h2>صدا، در کنار زندگی.</h2><p>گاهی به تمرکز نیاز داری؛ گاهی به همراهی در مسیر، یا موسیقی در خانه. آوان مجموعهٔ کوچکی از محصولات صوتی است که تفاوت مدل‌هایش را ساده و شفاف کنار هم می‌بینی.</p><p>کدهای مشخص، دو رنگ آرام و جزئیات مسی، زبان مشترک این مجموعه‌اند. هر مدل کاربرد خود را دارد و انتخاب به نیاز تو برمی‌گردد.</p><a class="btn" href={avanUrl('guide/')}>مدل مناسب خودت را پیدا کن</a></div><Photo source="/images/avan/editorial/editorial-focus.webp" alt="هدفون آوان همراه با یک فضای کار آرام" sizes="(max-width:767px) 90vw, 45vw"/></section><section class="prose"><h2>یک فروشگاه مفهومی، با انتخاب‌های روشن</h2><p>آوان یک نمونه‌کار طراحی فروشگاه است. محصولات و تصاویر برای همین هویت ساخته شده‌اند؛ قیمت‌ها و مشخصات، دادهٔ نمونه هستند. هیچ سفارش واقعی ارسال نمی‌شود و پرداختی دریافت نمی‌کنیم.</p></section></>}
{page==='help/shipping'&&<><Intro title="ارسال، پیش از انتخاب روشن است." description="قواعد ارسال نمونه را قبل از ثبت سفارش آزمایشی ببین."/><div class="prose"><h2>هزینهٔ ارسال عادی</h2><p>هزینهٔ ثابت ارسال ۱۰۰٬۰۰۰ تومان است. اگر جمع محصولات پس از تخفیف به ۸٬۰۰۰٬۰۰۰ تومان برسد، ارسال رایگان محاسبه می‌شود.</p><h2>مبلغ نهایی</h2><p>هزینهٔ ارسال و تخفیف جدا از جمع محصولات نمایش داده می‌شوند. پیش از ثبت نهایی، مدل، رنگ، تعداد و مبلغ را دوباره بازبینی می‌کنی.</p><h2>این سفارش، آزمایشی است</h2><p>در این فروشگاه مفهومی، محصولی ارسال نمی‌شود. نشانی و شمارهٔ تماس نمونه تنها داخل فرم همین صفحه استفاده می‌شوند.</p><a href={avanUrl('help/faq/')}>پرسش‌های رایج</a></div></>}
{page==='help/returns'&&<><Intro title="انتخابت را با خیال روشن بازبینی کن." description="رنگ، مدل و تعداد را پیش از ثبت سفارش آزمایشی بررسی کن."/><div class="prose"><h2>پیش از ثبت</h2><p>می‌توانی هر محصول را از سبد حذف کنی، تعداد را تغییر بدهی یا به صفحهٔ محصول برگردی و رنگ دیگری انتخاب کنی. مبلغ با انتخاب تازه دوباره محاسبه می‌شود.</p><h2>پس از ثبت آزمایشی</h2><p>این نمونه فروشگاه، پرداخت و ارسال واقعی ندارد؛ بنابراین درخواست مرجوعی واقعی ثبت نمی‌شود. رسید نمونه فقط مدل‌ها، رنگ‌ها، تعداد و مبلغ را نشان می‌دهد.</p><h2>راهنمای انتخاب</h2><p>اگر بین مدل‌ها مرددی، از مقایسهٔ هم‌گروه‌ها یا راهنمای کاربرد و بودجه کمک بگیر.</p><a href={avanUrl('compare/')}>مقایسهٔ محصولات</a></div></>}
{page==='help/faq'&&<><Intro title="پاسخ‌های کوتاه، انتخاب روشن‌تر." description="آنچه پیش از انتخاب در آوان باید بدانی."/><div class="prose"><details><summary>آیا خرید و پرداخت واقعی انجام می‌شود؟</summary><p>خیر. این فروشگاه یک نمونه‌کار مفهومی است. ثبت سفارش آزمایشی هزینه‌ای ندارد و محصولی ارسال نمی‌شود.</p></details><details><summary>چرا قیمت دو رنگ یک مدل فرق دارد؟</summary><p>هر ترکیب مدل و رنگ، قیمت و موجودی نمونهٔ مستقل دارد. قیمت دقیق رنگ انتخاب‌شده در صفحهٔ محصول و سبد دیده می‌شود.</p></details><details><summary>چه مدل‌هایی قابل مقایسه‌اند؟</summary><p>تا سه هدفون، سه ایرباد یا دو اسپیکر از یک گروه را می‌توان کنار هم دید. استند و کابل کاربرد متفاوت دارند و مقایسهٔ فنی هم‌گروه برای آن‌ها نداریم.</p></details><details><summary>آیا کابل A02 برای همهٔ محصولات مناسب است؟</summary><p>این کابل USB-A به USB-C برای شارژ H01، H02، E01، E02، E03 و S01 معرفی شده است. H03 سیمی و S02 با آداپتور DC در این فهرست نیستند.</p></details><details><summary>هزینهٔ ارسال چگونه محاسبه می‌شود؟</summary><p>ارسال عادی ۱۰۰٬۰۰۰ تومان است و از ۸ میلیون تومان پس از تخفیف رایگان می‌شود. سبد خالی هزینهٔ ارسال ندارد.</p></details><details><summary>کد AVAN10 چه تخفیفی می‌دهد؟</summary><p>۱۰ درصد جمع محصولات تا سقف ۶۰۰٬۰۰۰ تومان. مبلغ نهایی و ارسال پس از اعمال تخفیف دوباره محاسبه می‌شوند.</p></details><details><summary>اطلاعات فرم کجا نگه داشته می‌شود؟</summary><p>فقط در حافظهٔ همین صفحه و تا پیش از بازخوانی آن. اطلاعات شخصی در رسید نمونه ذخیره نمی‌شود.</p></details></div></>}
