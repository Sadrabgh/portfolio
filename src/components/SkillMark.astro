---
interface Props {
  skill: string;
}
const { skill } = Astro.props;
---

<svg width="90" height="90" viewBox="0 0 90 90" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {skill === "frontend" && (
    <>
      <rect x="8" y="13" width="74" height="64" rx="8" />
      <path d="M8 30h74m-56 0v47m12-32-9 9 9 9m26-18 9 9-9 9M54 40l-8 28" />
      <path d="M17 22h1m9 0h1m9 0h1" />
    </>
  )}
  {skill === "backend" && (
    <>
      {[12, 36, 60].map((y) => (
        <>
          <rect x="14" y={y} width="62" height="18" rx="5" />
          <circle cx="25" cy={y + 9} r="2" fill="currentColor" stroke="none" />
          <path d={`M56 ${y + 9}h10`} />
        </>
      ))}
      <path d="M45 30v6m0 18v6" />
    </>
  )}
  {skill === "api" && (
    <>
      <rect x="5" y="29" width="24" height="32" rx="6" />
      <rect x="59" y="5" width="25" height="26" rx="6" />
      <rect x="59" y="59" width="25" height="26" rx="6" />
      <path d="M29 45h14V18h16M43 45v27h16m-8-61 8 7-8 7m0 40 8 7-8 7" />
      <path d="M14 39h6m-6 12h6m49-33h7m-7 54h7" stroke-width="3" />
    </>
  )}
  {skill === "database" && (
    <>
      <ellipse cx="45" cy="17" rx="30" ry="11" />
      <path d="M15 17v53c0 6 13 12 30 12s30-6 30-12V17M15 35c0 6 13 11 30 11s30-5 30-11M15 53c0 6 13 11 30 11s30-5 30-11" />
    </>
  )}
  {skill === "testing" && (
    <>
      <rect x="8" y="12" width="74" height="64" rx="8" />
      <path d="M8 30h74m-62-9h1m10 0h1m10 0h1M20 45l8 8-8 8m17 0h10" />
      <path d="m53 52 8 8 13-16" stroke-width="5" />
    </>
  )}
  {skill === "devops" && (
    <>
      <path d="M20 42C7 42 6 22 20 20c3-15 26-19 35-6 14-5 28 7 24 22" />
      <path d="M45 57c-9-12-13-18-22-18a18 18 0 1 0 0 36c9 0 13-6 22-18s13-18 22-18a18 18 0 1 1 0 36c-9 0-13-6-22-18Z" stroke-width="5" />
    </>
  )}
</svg>
