---
import Brand from "../../../layouts/Brand.astro";
import Study from "../../../components/StudyStage.astro";
import { url } from "../../../config";
---

<Brand brand="neva" title="راهنمای مراجعه" current="guide">
  <main id="demo-main" class="wrap section">
    <span class="eyebrow">VISIT GUIDE</span>
    <h1>
      قبل از مراجعه،
      <br />
      مسیر را بشناسید.
    </h1>
    <div class="two-col section">
      <div>
        <h2>رزرو در این نمونه</h2>
        <ol class="guide-list">
          <li>
            <strong>نوع خدمت و پزشک</strong>
            <p>مدت و هزینهٔ فرضی پیش از انتخاب نشان داده می‌شوند.</p>
          </li>
          <li>
            <strong>روز و ساعت</strong>
            <p>
              زمان‌ها به وقت تهران‌اند. روز گذشته و زمان رزروشده قابل انتخاب
              نیستند.
            </p>
          </li>
          <li>
            <strong>اطلاعات آزمایشی و بازبینی</strong>
            <p>
              نام و شماره در حافظهٔ فرم می‌مانند و در ذخیرهٔ نوبت نگهداری
              نمی‌شوند.
            </p>
          </li>
          <li>
            <strong>مدیریت نوبت</strong>
            <p>
              نوبت‌های نمایشی همین مرورگر را می‌توانید جابه‌جا یا پس از تأیید
              لغو کنید.
            </p>
          </li>
        </ol>
        <a class="button" href={url("demo/neva/book/")}>
          شروع رزرو نمایشی
        </a>
      </div>
      <div>
        <h2>پرسش‌های رایج</h2>
        {[
          [
            "آیا نوبت واقعی ثبت می‌شود؟",
            "خیر. این نمونهٔ تعاملی برای ارزیابی طراحی است و به سامانهٔ درمانی متصل نیست.",
          ],
          [
            "چه چیزی روی مرورگر ذخیره می‌شود؟",
            "فقط شناسه، نوع پزشک، روز، ساعت و وضعیت نوبت نمایشی. نام، شماره یا شرح پزشکی ذخیره نمی‌شود.",
          ],
          [
            "چطور زمان را تغییر دهم؟",
            "از نوبت‌های من، جابه‌جایی را انتخاب کنید. زمان قبلی تا تأیید جایگزین حفظ می‌شود.",
          ],
          [
            "آیا اطلاعات پزشکان واقعی است؟",
            "پروفایل‌ها و تصاویر فرضی‌اند و سابقه، مدرک یا صلاحیت واقعی ادعا نمی‌کنند.",
          ],
        ].map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
    <section>
      <div class="section-head">
        <div>
          <span class="eyebrow">آشنایی اختیاری با محیط</span>
          <h2>از پذیرش تا اتاق مراجعه.</h2>
        </div>
        <p class="muted">ماکت مفهومی؛ نشانی واقعی ارائه نمی‌شود.</p>
      </div>
      <Study
        kind="clinic"
        variant="clinic"
        image="art/v10/neva-clinic.webp"
        label="ماکت مفهومی پذیرش نِوا"
      />
    </section>
  </main>
</Brand>
