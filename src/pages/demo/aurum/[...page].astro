---
import Aurum from "../../../layouts/Aurum.astro";
import Home from "../../../components/aurum/Home.astro";
import Shop from "../../../components/aurum/Shop.astro";
import Product from "../../../components/aurum/Product.astro";
import Checkout from "../../../components/aurum/Checkout.astro";
import Photo from "../../../components/aurum/Photo.astro";
import Card from "../../../components/aurum/Card.astro";
import Icon from "../../../components/aurum/Icon.astro";
import Guides from "../../../components/aurum/Guides.astro";
import {
  products,
  collections,
  articles,
  help,
  faq,
  link,
} from "../../../data/aurum";
export function getStaticPaths() {
  return [
    "",
    "shop",
    ...products.map((p) => "products/" + p.id),
    "collections",
    ...collections.map((c) => "collections/" + c.id),
    "story",
    "journal",
    ...articles.map((a) => "journal/" + a.id),
    "saved",
    "cart",
    "checkout",
    "order",
    "contact",
    ...Object.keys(help).map((k) => "help/" + k),
  ].map((page) => ({ params: { page: page || undefined }, props: { page } }));
}
const { page } = Astro.props;
const product = products.find((p) => "products/" + p.id === page);
const collection = collections.find((c) => "collections/" + c.id === page);
const article = articles.find((a) => "journal/" + a.id === page);
const info = help[page.replace("help/", "")];
const titles: Record<string, string> = {
  "": "جزئیات کوچک، درخشش ماندگار",
  shop: "زیورآلات",
  collections: "کالکشن‌ها",
  story: "داستان آوروم",
  journal: "مجله",
  saved: "علاقه‌مندی‌ها",
  cart: "سبد خرید",
  checkout: "تکمیل سفارش",
  order: "رسید سفارش آزمایشی",
  contact: "همراه انتخاب شما",
};
---

<Aurum
  title={
    product?.name ||
    collection?.name ||
    article?.title ||
    info?.title ||
    titles[page]
  }
  page={page || "home"}
>
  {page === "" && <Home />}
  {page === "shop" && <Shop />}
  {product && <Product product={product} />}
  {page === "checkout" && <Checkout />}
  {page === "collections" && (
    <>
      <section class="au-wrap au-content-page">
        <div class="au-page-intro">
          <span class="au-eyebrow">منتخب‌هایی با نگاه متفاوت</span>
          <h1>
            روزمره،
            <br /> به سلیقهٔ شما.
          </h1>
          <p>
            سه مسیر برای کشف مجموعه. از یک فرم محبوب شروع کنید و ترکیب خودتان را
            بسازید.
          </p>
        </div>
        <div class="au-collection-grid">
          {collections.map((c) => (
            <a
              class="au-collection-card"
              href={link("collections/" + c.id + "/")}
            >
              <Photo name={c.image} alt={c.name} />
              <div>
                <h2>{c.name}</h2>
                <Icon />
              </div>
              <p>{c.subtitle}</p>
              <p>{c.description}</p>
            </a>
          ))}
        </div>
      </section>
      <Guides />
    </>
  )}
  {collection && (
    <>
      <section class="au-wrap au-content-page">
        <a class="au-text-link" href={link("collections/")}>
          → همهٔ کالکشن‌ها
        </a>
        <div class="au-collection-hero">
          <div>
            <span class="au-eyebrow">منتخب آوروم</span>
            <h1>{collection.name}</h1>
            <p>{collection.subtitle}</p>
            <p>{collection.description}</p>
            <a
              class="au-text-link"
              href={link("journal/building-a-collection/")}
            >
              راهنمای ساخت مجموعهٔ شخصی <Icon />
            </a>
          </div>
          <Photo
            name={collection.image}
            alt={collection.name}
            eager
            sizes="(max-width:700px) 94vw, 55vw"
          />
        </div>
        <div class="au-grid">
          {products
            .filter((p) => collection.ids.includes(p.id))
            .map((p) => (
              <Card product={p} />
            ))}
        </div>
      </section>
      <Guides />
    </>
  )}
  {page === "story" && (
    <section class="au-story">
      <div class="au-wrap au-page-intro">
        <span class="au-eyebrow">آوروم؛ نگاه ما</span>
        <h1>
          جزئیات کوچک.
          <br /> دنیایی شخصی.
        </h1>
        <p>سادگی، جا را برای سلیقهٔ شما باز می‌کند.</p>
      </div>
      <div class="au-editorial">
        <div class="au-editorial-copy">
          <h2>
            برای هر روزِ
            <br /> شما.
          </h2>
          <span class="au-short-line"></span>
          <p>
            یک انحنای نرم، یک خط روشن و کمی درخشش. آوروم زیورآلات را بخشی از
            زندگی روزمره می‌بیند؛ قطعه‌هایی که کنار لباس‌های محبوب شما جا
            می‌گیرند.
          </p>
          <p>
            نام آوروم از واژهٔ لاتین «طلا» می‌آید. در این مجموعهٔ مستقل، رنگ
            طلایی در کنار سبز نعنایی قرار گرفته تا گرما و آرامش را هم‌زمان روایت
            کند.
          </p>
          <p>
            این فروشگاه یک نمونه‌کار مفهومی است؛ فرم‌ها و تصاویر برای همین هویت
            ساخته شده‌اند و مسیر انتخاب تا رسید سفارش قابل تجربه است.
          </p>
        </div>
        <div class="au-editorial-image">
          <Photo
            name="campaign"
            alt="گوشوارهٔ سادهٔ طلایی و یقهٔ سبز روشن"
            eager
            sizes="(max-width:700px) 100vw, 50vw"
          />
        </div>
      </div>
      <div class="au-wrap au-story-notes" data-au-reveal>
        {[
          [
            "از فرم شروع می‌کنیم.",
            "سطح‌های صیقلی، لبه‌های نرم و تناسب‌هایی که بدون شلوغی دیده می‌شوند.",
          ],
          [
            "انتخاب روشن.",
            "مشخصات، اندازه و راهنمای نگه‌داری کنار هر قطعه قرار دارند تا انتخاب آسان‌تر شود.",
          ],
          [
            "مجموعهٔ شخصی شما.",
            "یک قطعهٔ محبوب کافی است؛ باقی مجموعه را بر اساس زندگی و سلیقهٔ خودتان بسازید.",
          ],
        ].map(([title, text]) => (
          <div>
            <h2>{title}</h2>
            <p>{text}</p>
          </div>
        ))}
      </div>
      <div class="au-wrap au-story-end">
        <Photo name="hand" alt="انگشتر طلایی پهن در کنار پارچهٔ سبز روشن" />
        <div>
          <span class="au-eyebrow">کمتر، اما انتخاب‌شده</span>
          <h2>
            درخشش
            <br /> به سبک شما.
          </h2>
          <p>
            قطعه‌ای را پیدا کنید که هم به‌تنهایی دوستش دارید و هم کنار
            انتخاب‌های دیگر شما دیده می‌شود.
          </p>
          <a class="au-button" href={link("shop/")}>
            کشف زیورآلات <Icon />
          </a>
        </div>
      </div>
    </section>
  )}
  {page === "journal" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">یادداشت‌های آوروم</span>
        <h1>
          پیش از
          <br /> انتخاب.
        </h1>
        <p>
          از شناخت فرم تا انتخاب هدیه و مراقبت روزمره؛ چند نگاه برای انتخابی
          شخصی‌تر.
        </p>
      </div>
      <div class="au-journal-grid">
        {articles.map((a) => (
          <a href={link("journal/" + a.id + "/")} class="au-journal-card">
            <Photo name={a.image} alt={a.title} />
            <span class="au-eyebrow">{a.tag}</span>
            <h2>
              {a.title}
              <Icon />
            </h2>
            <p>{a.intro}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  {article && (
    <>
      <article class="au-wrap au-article">
        <a class="au-text-link" href={link("journal/")}>
          → همهٔ یادداشت‌ها
        </a>
        <div class="au-page-intro">
          <span class="au-eyebrow">{article.tag}</span>
          <h1>{article.title}</h1>
          <p>{article.intro}</p>
        </div>
        <Photo
          name={article.image}
          alt={article.title}
          eager
          sizes="(max-width:700px) 94vw, 80vw"
        />
        <div class="au-prose">
          {article.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          <a class="au-text-link" href={link("shop/")}>
            کشف مجموعه <Icon />
          </a>
        </div>
      </article>
      <section class="au-wrap au-related">
        <div class="au-section-head">
          <h2>همراه این یادداشت.</h2>
        </div>
        <div class="au-grid">
          {products
            .filter((p) => article.related.includes(p.id))
            .map((p) => (
              <Card product={p} />
            ))}
        </div>
      </section>
    </>
  )}
  {page === "saved" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">منتخب شخصی شما</span>
        <h1>
          برای بعد،
          <br /> نگه دارید.
        </h1>
        <p>
          قطعه‌های محبوب را کنار هم ببینید، مقایسه کنید و هر زمان آماده بودید
          انتخاب کنید.
        </p>
      </div>
      <div class="au-grid" data-saved-grid>
        {products.map((p) => (
          <Card product={p} saved />
        ))}
      </div>
      <div class="au-empty" data-saved-empty hidden>
        <h2>از یک قطعهٔ محبوب شروع کنید.</h2>
        <p>قلب کنار هر محصول را بزنید تا به این مجموعه اضافه شود.</p>
        <a class="au-button" href={link("shop/")}>
          کشف مجموعه <Icon />
        </a>
      </div>
      <div class="au-help-strip">
        <p>
          هنوز بین چند فرم مانده‌اید؟ راهنمای انتخاب می‌تواند شروع خوبی باشد.
        </p>
        <a class="au-text-link" href={link("journal/finding-your-form/")}>
          پیدا کردن فرم دلخواه <Icon />
        </a>
      </div>
    </section>
  )}
  {page === "cart" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">انتخاب‌های شما</span>
        <h1>
          کنار هم،
          <br /> زیباتر.
        </h1>
        <p>اندازه و تعداد را بررسی کنید؛ بعد به مرحلهٔ سفارش آزمایشی بروید.</p>
      </div>
      <div class="au-cart-layout">
        <div data-bag-lines="page"></div>
        <aside class="au-summary">
          <h2>سبد خرید.</h2>
          <div class="au-total-row">
            <span>جمع محصولات</span>
            <strong data-subtotal>۰ تومان</strong>
          </div>
          <p>هزینهٔ ارسال و بسته‌بندی هدیه در مرحلهٔ بعد مشخص می‌شود.</p>
          <a class="au-button" href={link("checkout/")} data-checkout-link>
            تکمیل سفارش <Icon />
          </a>
          <a class="au-text-link" href={link("shop/")}>
            ادامهٔ انتخاب <Icon />
          </a>
          <a class="au-text-link" href={link("help/shipping/")}>
            راهنمای ارسال <Icon />
          </a>
        </aside>
      </div>
    </section>
  )}
  {page === "order" && (
    <section class="au-wrap au-order au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">سفارش آزمایشی شما</span>
        <h1>
          انتخابی
          <br /> به سلیقهٔ شما.
        </h1>
        <p>این رسید نمایشی است؛ پرداخت یا ارسال واقعی انجام نشده است.</p>
      </div>
      <div data-receipt>
        <h2>در این نشست رسیدی ندارید.</h2>
        <p>برای تجربهٔ مسیر سفارش، ابتدا یک قطعه انتخاب کنید.</p>
        <a class="au-button" href={link("shop/")}>
          کشف مجموعه <Icon />
        </a>
      </div>
      <div class="au-help-strip">
        <p>رسید بدون اطلاعات تماس در همین نشست مرورگر نگه‌داری می‌شود.</p>
        <a class="au-text-link" href={link("help/privacy/")}>
          حریم خصوصی <Icon />
        </a>
      </div>
    </section>
  )}
  {info && (
    <section class="au-wrap au-information">
      <a class="au-text-link" href={link("shop/")}>
        → بازگشت به مجموعه
      </a>
      <div class="au-page-intro">
        <span class="au-eyebrow">همراه انتخاب شما</span>
        <h1>{info.title}</h1>
        <p>{info.intro}</p>
      </div>
      <nav class="au-help-nav" aria-label="راهنماهای خرید">
        {Object.entries(help).map(([id, data]) => (
          <a
            href={link("help/" + id + "/")}
            aria-current={page === "help/" + id ? "page" : undefined}
          >
            {data.title}
          </a>
        ))}
      </nav>
      <div class="au-info-sections">
        {info.sections.map(([heading, text]) => (
          <section>
            <h2>{heading}</h2>
            <p>{text}</p>
          </section>
        ))}
      </div>
      <a class="au-button" href={link("contact/")}>
        راهنمایی بیشتر <Icon />
      </a>
    </section>
  )}
  {page === "contact" && (
    <>
      <section class="au-wrap au-contact">
        <div class="au-page-intro">
          <span class="au-eyebrow">همراه انتخاب شما</span>
          <h1>
            دربارهٔ انتخابتان
            <br /> صحبت کنیم.
          </h1>
          <p>
            اندازه، یک جزئیات یا ایده‌ای برای هدیه؛ موضوع را انتخاب کنید و فرم
            نمایشی را امتحان کنید.
          </p>
          <a class="au-text-link" href={link("help/size-guide/")}>
            راهنمای اندازه <Icon />
          </a>
          <a class="au-text-link" href={link("help/shipping/")}>
            ارسال و بسته‌بندی <Icon />
          </a>
        </div>
        <form data-contact-form>
          <fieldset disabled data-client-enable>
            <legend>پیام شما</legend>
            <label>
              نام شما
              <input
                name="name"
                required
                maxlength="80"
                placeholder="نام نمونه"
              />
            </label>
            <label>
              نشانی ایمیل
              <input
                name="email"
                type="email"
                dir="ltr"
                required
                maxlength="120"
                placeholder="name@example.com"
              />
            </label>
            <label>
              موضوع
              <select name="subject">
                <option value="size">اندازه و انتخاب محصول</option>
                <option value="gift">انتخاب هدیه</option>
                <option value="care">نگه‌داری و مراقبت</option>
                <option value="other">موضوع دیگر</option>
              </select>
            </label>
            <label>
              چطور می‌توانیم راهنمایی کنیم؟
              <textarea
                name="message"
                required
                rows="5"
                maxlength="1000"
                placeholder="کمی دربارهٔ انتخابتان بنویسید…"
              ></textarea>
            </label>
            <p class="au-note">
              فرم نمایشی است؛ پیام شما ارسال یا ذخیره نمی‌شود.
            </p>
            <button class="au-button">
              پیش‌نمایش درخواست <Icon />
            </button>
          </fieldset>
          <p data-contact-feedback class="au-form-feedback" role="status"></p>
        </form>
      </section>
      <section class="au-wrap au-home-section au-faq">
        <div>
          <h2>پیش از پیام.</h2>
        </div>
        <div class="au-product-details">
          {faq.map(([q, a]) => (
            <details>
              <summary>
                {q}
                <span>+</span>
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>
    </>
  )}
</Aurum>
