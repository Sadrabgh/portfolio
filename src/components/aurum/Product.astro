---
import { products, link, money, type Jewel } from "../../data/aurum";
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import Card from "./Card.astro";
import Guides from "./Guides.astro";
import { optionText, categoryText, number } from "../../data/aurum-locale";
interface Props {
  product: Jewel;
}
const { product: p } = Astro.props;
const related = products
  .filter((x) => x.id !== p.id)
  .sort(
    (a, b) =>
      Number(b.category === p.category) - Number(a.category === p.category),
  )
  .slice(0, 3);
---

<div class="au-wrap au-breadcrumb">
  <a href={link()}>خانه</a>
  <span>/</span>
  <a href={link("shop/?category=" + p.category)}>{categoryText(p.category)}</a>
  <span>/</span>
  <span>{p.name}</span>
</div>
<section class="au-wrap au-product">
  <div class="au-product-image">
    <Photo
      transitionName={"aurum-product-" + p.id}
      name={p.id}
      alt={p.name + " با سطح طلایی صیقلی"}
      eager
      sizes="(max-width: 700px) 94vw, 52vw"
    />
  </div>
  <div class="au-product-copy">
    <span class="au-eyebrow">مجموعهٔ روزمره</span>
    <h1>{p.name}</h1>
    <span class="au-product-price">{money(p.price)}</span>
    <p class="au-product-description">{p.description}</p>
    <span class="au-material">{p.material}</span>
    <form data-product-form={p.id} class="au-product-form">
      <label>
        {p.optionLabel}
        <select name="option" required>
          {p.options.length > 1 && (
            <option value="" disabled selected>
              انتخاب {p.category === "rings" ? "اندازه" : "طول"}
            </option>
          )}
          {p.options.map((o) => (
            <option value={o}>{optionText(o)}</option>
          ))}
        </select>
      </label>
      <label>
        تعداد
        <select name="quantity">
          {Array.from({ length: p.stock }, (_, i) => (
            <option value={i + 1}>{number(i + 1)}</option>
          ))}
        </select>
      </label>
      <div class="au-product-actions">
        <button type="submit" class="au-button">
          افزودن به سبد
          <Icon name="plus" />
        </button>
        <button
          class="au-icon au-save-product"
          type="button"
          data-save={p.id}
          aria-label={"ذخیرهٔ " + p.name}
          aria-pressed="false"
        >
          <Icon name="heart" />
        </button>
      </div>
      <p
        class="au-form-feedback"
        data-feedback
        role="status"
        aria-live="polite"
      ></p>
    </form>
    <a class="au-text-link au-size-link" href={link("help/size-guide/")}>
      راهنمای اندازه
      <Icon />
    </a>
    <div class="au-product-details">
      <details open>
        <summary>
          نگاهی نزدیک‌تر<span>+</span>
        </summary>
        <p>{p.detail}</p>
        <dl class="au-specs">
          {p.specs.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </details>
      <details>
        <summary>
          مراقبت روزمره<span>+</span>
        </summary>
        <p>
          هر قطعه را جداگانه نگه دارید و پس از استفاده با پارچهٔ نرم تمیز کنید.
          پیش از شنا، ورزش یا کار با مواد شوینده، زیورآلات را کنار بگذارید.
        </p>
        <a href={link("help/care/")}>راهنمای مراقبت ↖</a>
      </details>
      <details>
        <summary>
          ارسال و بازگشت<span>+</span>
        </summary>
        <p>
          سفارش در این فروشگاه آزمایشی است. می‌توانید ارسال و بسته‌بندی را
          انتخاب کنید؛ پرداخت و ارسال واقعی انجام نمی‌شود.
        </p>
        <a href={link("help/shipping/")}>گزینه‌های ارسال ↖</a>
      </details>
    </div>
  </div>
</section>
<section class="au-wrap au-related">
  <div class="au-section-head">
    <h2>در کنار این قطعه.</h2>
    <a class="au-text-link" href={link("shop/")}>
      تمام زیورآلات
      <Icon />
    </a>
  </div>
  <div class="au-grid">
    {related.map((x) => (
      <Card product={x} />
    ))}
  </div>
</section>

<Guides />
