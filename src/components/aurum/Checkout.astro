---
import { link } from "../../data/aurum";
import Icon from "./Icon.astro";
---

<section class="au-wrap au-page-intro au-checkout-intro">
  <span class="au-eyebrow">انتخاب‌های شما، مرحلهٔ آخر</span>
  <h1>کمی تا تکمیل انتخاب.</h1>
  <p>
    با اطلاعات نمونه، مسیر کامل سفارش را تجربه کنید. پرداخت واقعی انجام نمی‌شود.
  </p>
</section>
<section class="au-wrap au-checkout" data-checkout>
  <div>
    <ol class="au-steps" aria-label="مراحل سفارش">
      <li data-step="details" aria-current="step">
        <span>۰۱</span> اطلاعات شما
      </li>
      <li data-step="review">
        <span>۰۲</span> بازبینی
      </li>
    </ol>
    <div data-checkout-empty hidden class="au-empty">
      <h2>سبدتان هنوز خالی است.</h2>
      <p>ابتدا یک قطعه انتخاب کنید، سپس سفارش را ادامه دهید.</p>
      <a class="au-button" href={link("shop/")}>
        کشف مجموعه
        <Icon />
      </a>
    </div>
    <form data-checkout-form>
      <fieldset disabled data-client-enable>
        <legend>تماس و نشانی</legend>
        <div class="au-form-grid">
          <label>
            نام و نام خانوادگی
            <input
              name="name"
              autocomplete="off"
              required
              maxlength="80"
              placeholder="نام نمونه"
            />
          </label>
          <label>
            نشانی ایمیل
            <input
              name="email"
              type="email"
              dir="ltr"
              autocomplete="off"
              required
              maxlength="120"
              placeholder="alex@example.com"
            />
          </label>
          <label class="au-field-wide">
            نشانی خیابان
            <input
              name="address"
              autocomplete="off"
              required
              maxlength="160"
              placeholder="خیابان نمونه، پلاک ۱۲"
            />
          </label>
          <label>
            شهر
            <input
              name="city"
              required
              maxlength="80"
              placeholder="شهر نمونه"
            />
          </label>
          <label>
            کد پستی
            <input name="postal" required maxlength="20" placeholder="۱۲۳۴۵" />
          </label>
        </div>
        <label class="au-shipping">
          روش ارسال
          <select name="shipping">
            <option value="standard">
              عادی · ۱۲۰٬۰۰۰ تومان؛ رایگان از ۶۰ میلیون
            </option>
            <option value="express">سریع · ۲۴۰٬۰۰۰ تومان</option>
          </select>
        </label>
        <label class="au-check">
          <input type="checkbox" name="gift" /> بسته‌بندی هدیه · ۱۸۰٬۰۰۰ تومان
        </label>
        <div class="au-coupon">
          <label>
            کد نمایشی AURUM10
            <input
              name="coupon"
              dir="ltr"
              placeholder="کد اختیاری"
              maxlength="20"
            />
          </label>
          <button type="button" class="au-button au-outline" data-apply-code>
            اعمال کد
          </button>
        </div>
        <p class="au-form-feedback" data-coupon-feedback role="status"></p>
        <button type="submit" class="au-button">
          بازبینی سفارش
          <Icon />
        </button>
      </fieldset>
    </form>
    <section data-review hidden aria-labelledby="au-review-title">
      <h2 id="au-review-title" tabindex="-1">
        یک نگاه پیش از ثبت.
      </h2>
      <div class="au-review-contact"></div>
      <p class="au-note">
        این سفارش آزمایشی است. اطلاعات تماس فقط روی همین صفحه نمایش داده می‌شوند
        و ذخیره یا ارسال نمی‌شوند.
      </p>
      <div class="au-review-actions">
        <button class="au-button" type="button" data-place-order>
          ثبت سفارش آزمایشی
          <Icon name="check" />
        </button>
        <button class="au-text-link" data-back-details type="button">
          ویرایش اطلاعات
        </button>
      </div>
      <p class="au-form-feedback" data-order-feedback role="status"></p>
    </section>
  </div>
  <aside class="au-summary">
    <h2>انتخاب‌های شما.</h2>
    <div data-summary-lines></div>
    <div class="au-totals" data-checkout-totals></div>
    <a class="au-text-link" href={link("cart/")}>
      ویرایش سبد
      <Icon />
    </a>
  </aside>
</section>
