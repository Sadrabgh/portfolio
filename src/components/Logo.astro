---
import mark from "../assets/brand/studio-mark.svg?raw";
const { horizontal = false } = Astro.props;
---

<span class:list={["studio-logo", { "studio-logo-horizontal": horizontal }]}>
  <Fragment set:html={mark} />
  <span class="logo-type">
    <span>استودیو</span>
    <span>طراحی</span>
  </span>
</span>
