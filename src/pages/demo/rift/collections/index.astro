---
import Brand from "../../../../layouts/Brand.astro";
import Cart from "../../../../components/RiftCart.astro";
import { url } from "../../../../config";
---

<Brand brand="rift" title="کالکشن‌ها" current="collections">
  <main id="demo-main" class="wrap section">
    <span class="eyebrow">COLLECTIONS / DROP 001</span>
    <h1>دو نگاه به روزمره.</h1>
    <div class="rift-collection-index">
      <a href={url("demo/rift/collections/layers/")}>
        <img
          src={url("art/v10/campaign.webp")}
          alt="کالکشن لایه‌ها"
          width="1536"
          height="1024"
        />
        <span>۰۱ / لایه‌ها ↗</span>
      </a>
      <a href={url("demo/rift/collections/essentials/")}>
        <img
          src={url("art/v10/cargo-stone.webp")}
          alt="کالکشن روزمره‌ها"
          width="1024"
          height="1536"
        />
        <span>۰۲ / روزمره‌ها ↗</span>
      </a>
    </div>
  </main>
  <Cart />
</Brand>
