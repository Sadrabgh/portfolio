---
import SkillMark from "./SkillMark.astro";
const tools = [
  ["frontend", "DESIGN", "طراحی رابط فروشگاه", "صفحه‌هایی هماهنگ با برند شما"],
  ["backend", "BUILD", "پیاده‌سازی سایت", "اجرای طرح و جزئیات صفحه‌ها"],
  ["api", "SHOP", "مسیر خرید", "از پیدا‌کردن محصول تا سبد خرید"],
  ["database", "PRODUCT", "نمایش محصول", "تصاویر، مشخصات و انتخاب‌ها"],
  ["testing", "MOBILE", "موبایل و دسکتاپ", "چیدمان مناسب هر اندازهٔ صفحه"],
  ["devops", "MOTION", "موشن و تعامل", "حرکت روان و بازخورد روشن"],
];
---

<section class="expertise-section container">
  <h2 class="serif-section-title" data-motion-reveal>
    طراحی یک فروشگاه کامل
  </h2>
  <div class="expertise-grid">
    {tools.map(([id, code, t, description], i) => (
      <div class="expertise-item" data-skill={id} data-motion-reveal data-delay={i * 100}>
        <div class="expertise-pill">
          <span class="skill-mark" dir="ltr" aria-hidden="true">
            <SkillMark skill={id} />
          </span>
          <span class="skill-code" dir="ltr">{code}</span>
          <span class="skill-description">{description}</span>
        </div>
        <h3>{t}</h3>
      </div>
    ))}
  </div>
</section>
