---
import { url } from "../config";
import mark from "../assets/brand/studio-mark.svg?raw";
interface Props {
  priority?: boolean;
  src?: string;
  alt?: string;
  caption?: string;
}
const {
  priority = false,
  src = "portfolio/moonex/portrait-linen-color-v6.png",
  alt = "پرترهٔ رنگی با پیراهن لینن و ژست نشسته، در قاب بیضی",
  caption = "استودیو طراحی",
} = Astro.props;
---

<figure class="studio-portrait" data-motion-reveal>
  <div class="portrait-frame">
    <img
      class="portrait-photo"
      src={url(src)}
      alt={alt}
      width="814"
      height="1006"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
    <span class="portrait-signature" aria-hidden="true">
      <Fragment set:html={mark} />
    </span>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
