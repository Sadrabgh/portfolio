---
import Base from "../layouts/Base.astro";
import StudioPortrait from "../components/StudioPortrait.astro";
import Expertise from "../components/Expertise.astro";
import Experience from "../components/Experience.astro";
import ProjectQuotes from "../components/ProjectQuotes.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { site, url } from "../config";
---

<Base title="دربارهٔ استودیو">
  <section class="about-profile container">
    <div class="about-profile-copy">
      <div data-motion-reveal>
        <h1>{site.ownerName || "استودیو طراحی"}</h1>
        <p class="about-role">
          طراحی سایت فروشگاهی
          <br />
          از طراحی تا اجرای وب
        </p>
      </div>
      <div class="about-biography" data-motion-reveal data-delay="100">
        <span class="eyebrow">دربارهٔ کار من</span>
        <p>
          برای فروشگاه‌ها و کسب‌وکارها سایت طراحی و اجرا می‌کنم. هدفم این است
          که ظاهر سایت با برند شما هماهنگ باشد، محصولات واضح معرفی شوند و
          مشتری بتواند راحت‌تر انتخاب کند. ساختار صفحه‌ها، نسخهٔ موبایل و جزئیات
          تعامل را در کنار هم پیش می‌برم.
        </p>
      </div>
      <div class="about-contact" data-motion-reveal data-delay="200">
        <span class="eyebrow">تماس</span>
        <a href={url("contact/")}>
          دربارهٔ فروشگاهتان بگویید
          <br />
          شروع طراحی سایت
        </a>
        {site.email && (
          <a href={"mailto:" + site.email} dir="ltr">
            {site.email}
          </a>
        )}
      </div>
      <div class="about-services" data-motion-reveal data-delay="300">
        <span class="eyebrow">حوزه‌های طراحی</span>
        {[
          ["طراحی فروشگاه آنلاین", "۰۱"],
          ["طراحی و بازطراحی سایت", "۰۲"],
          ["نسخهٔ موبایل و دسکتاپ", "۰۳"],
          ["موشن و تعامل", "۰۴"],
          ["نمایش تعاملی محصول", "۰۵"],
        ].map(([t, n]) => (
          <a href={url("services/")}>
            <span>{t}</span>
            <small dir="ltr">{n}</small>
          </a>
        ))}
      </div>
    </div>
    <StudioPortrait priority />
  </section>
  <Expertise />
  <Experience />
  <ProjectQuotes />
  <ContactCTA />
</Base>
