---
import Brand from "../../../layouts/Brand.astro";
import Study from "../../../components/StudyStage.astro";
import { url } from "../../../config";
import Icon from "../../../components/Icon.astro";
---

<Brand brand="velo" title="دوچرخهٔ شهری، به انتخاب شما" current="">
  <main id="demo-main">
    <section class="wrap velo-showroom" data-velo>
      <div class="velo-stage" id="velo-scene">
        <div class="showroom-title"><div data-entry><span class="demo-kicker">VELO / A STUDY IN EVERYDAY MOTION</span><h1>حرکت،<br/><span>با یک نگاه تازه.</span></h1></div><div class="showroom-intro" data-entry><p>از خطِ فریم تا ریتمِ شهر.<br/>سه جزئیات را کشف کنید؛ سپس فرم خودتان را بسازید.</p><a class="button" href="#configure">پیکربندیِ من <Icon name="arrow" size={18}/></a></div></div>
        <div class="velo-stage-heading"><span dir="ltr">LIVE FORM / 01</span><span><Icon name="layers" size={16} /> بچرخانید. جزئیات را کشف کنید.</span></div>
        <Study
          kind="bike"
          variant="city"
          image="art/v10/velo-city-cyan.webp"
          label="دوچرخهٔ مفهومی VELO CITY"
          compact={true}
        />
        <div class="velo-stage-foot">
          <span dir="ltr" data-velo-code>
            CITY / CYAN / M
          </span>
          <span>مطالعهٔ فرم · جزئیات قابل بررسی</span>
        </div>
        <div class="velo-chapters" role="group" aria-label="فصل‌های داستان طراحی">{[["overview","00","نمای کامل"],["battery","01","بدنه"],["drive","02","حرکت"],["cockpit","03","شهر"]].map(([camera,n,label],i)=><button data-velo-chapter={camera} aria-pressed={i===0}><span dir="ltr">{n}</span><strong>{label}</strong><Icon name="arrow" size={16}/></button>)}</div>
        <div class="velo-story" aria-live="polite"><span class="eyebrow" data-velo-story-kicker>00 / THE WHOLE FORM</span><h2 data-velo-story-title>یک خط پیوسته، برای مسیر روزمره.</h2><p data-velo-story-text>فریم، تجهیزات و جزئیات را در کنار هم ببینید. برای بررسی مستقیم، مدل را با لمس یا کلیدهای جهت بچرخانید.</p></div>
      </div>
      <div class="velo-config-layout" id="configure">
        <div class="velo-config-editorial"><span class="eyebrow">YOUR RIDE / CONFIGURATION STUDIO</span><h2>فرمِ مسیر<br/>شما.</h2><p>سه ساختار، سه رنگ و جزئیاتی که انتخاب شما را کامل می‌کنند.</p><a class="text-link" href={url("demo/velo/compare/")}>تفاوت مدل‌ها را ببینید <Icon name="arrow" size={18}/></a>
        <div class="velo-live-choice"><div><span class="eyebrow">فرم انتخاب‌شده</span><strong data-velo-live-model dir="ltr">CITY</strong><p data-velo-live-description>خطوط پیوسته، تجهیزات کم؛ یک فرم برای حرکت روزمره.</p></div><div class="velo-live-chips"><span data-velo-live-color>فیروزه‌ای</span><span data-velo-live-finish>ساتن</span><span data-velo-live-size dir="ltr">FRAME M</span></div></div>
        <a class="text-link" href="#velo-scene">مشاهدهٔ انتخاب در مدل <Icon name="arrow" size={18}/></a></div>
      <aside class="velo-config">
        <span class="eyebrow">یک انتخاب شخصی</span>
        <h3>از مدل شروع کنید.</h3>
        <p class="config-intro">از مدل شروع کنید؛ هر انتخاب روی نمای سه‌بعدی اعمال می‌شود.</p>
        <fieldset>
          <legend><span class="config-step">۱</span> مدلِ حرکت</legend>
          <div class="velo-models">
            {[
              ["city", "CITY", "روزمره و مینیمال"],
              ["step", "STEP", "فریم با دسترسی باز"],
              ["tour", "TOUR", "فرم مجهز برای حمل"],
            ].map(([v, t, s], i) => (
              <button data-velo-model={v} aria-pressed={i === 0}>
                <b dir="ltr">{t}</b>
                <span>{s}</span>
                <i><Icon name="check" size={16} /></i>
              </button>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>
            <span class="config-step">۲</span> رنگ فریم: <span data-velo-color-label>فیروزه‌ای</span>
          </legend>
          <div class="velo-colors">
            {[
              ["cyan", "فیروزه‌ای", "#15b6c4"],
              ["ink", "گرافیت", "#33393e"],
              ["chalk", "سفید معدنی", "#deddd6"],
            ].map(([v, t, h], i) => (
              <button
                data-velo-color={v}
                aria-label={t}
                aria-pressed={i === 0}
                style={`--swatch:${h}`}
              >
                <span></span>
                <small>{t}</small>
              </button>
            ))}
          </div>
        </fieldset>
        <details class="config-advanced" data-config-advanced>
          <summary>جزئیاتِ شخصی‌سازی</summary>
        <fieldset>
          <legend>پرداخت سطح</legend>
          <div class="filters">
            {[
              ["satin", "ساتن"],
              ["gloss", "براق"],
            ].map(([v, t], i) => (
              <button data-velo-finish={v} aria-pressed={i === 0}>
                {t}
              </button>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>اندازهٔ نمایشی فریم</legend>
          <div class="filters" dir="ltr">
            {["S", "M", "L"].map((s) => (
              <button data-velo-size={s} aria-pressed={s === "M"}>
                {s}
              </button>
            ))}
          </div>
          <p class="muted small">
            اندازه‌ها برای بررسی فرم‌اند؛ راهنمای مهندسی یا اندازهٔ بدن نیستند.
          </p>
        </fieldset>
        <fieldset>
          <legend>محیط نمایش</legend>
          <div class="filters">
            {[
              ["studio", "استودیو"],
              ["city", "شهر"],
              ["park", "پارک"],
            ].map(([v, t], i) => (
              <button data-velo-environment={v} aria-pressed={i === 0}>
                {t}
              </button>
            ))}
          </div>
        </fieldset>
        </details>
        <button class="button" data-velo-summary>
          بازبینی انتخاب <Icon name="arrow" size={18} />
        </button>
        <div class="actions">
          <button class="text-link" data-velo-save>
            ذخیرهٔ پیکربندی
          </button>
          <button class="text-link" data-velo-load>
            بازیابی انتخاب
          </button>
        </div>
        <p class="status" data-velo-status role="status"></p>
        <details class="velo-share"><summary><Icon name="right" size={16} /> پیوند همین پیکربندی</summary><label for="velo-share-link">مدل، رنگ و جزئیات در این پیوند حفظ می‌شوند.</label><div><input id="velo-share-link" data-velo-share-link readonly dir="ltr" type="url" /><button type="button" data-velo-copy aria-label="کپی پیوند پیکربندی"><Icon name="code" size={18} /><span data-control-label>کپی</span></button></div></details>
        <p class="flow-assurance"><Icon name="shield" size={16} /> ذخیرهٔ انتخاب فقط در همین مرورگر؛ بدون ثبت سفارش.</p>
      </aside>
      </div>
    </section>
    <section class="wrap section velo-details" data-motion-scene>
      <div data-reveal>
        <span class="eyebrow">DESIGNED TO BE SEEN</span>
        <h2>
          جزئیات،
          <br />
          بخشی از فرم‌اند.
        </h2>
        <p>
          باتری یکپارچه در لولهٔ پایین، مسیر انتقال حرکت و مجموعهٔ فرمان در مدل
          قابل بررسی‌اند.
        </p>
        <a class="text-link" href={url("demo/velo/design/")}>
          داستان طراحی و اجزا ↗
        </a>
      </div>
      <div class="velo-feature-list">
        {[
          [
            "01",
            "فریم یکپارچه",
            "اتصالات، پوشش باتری و کابل‌ها در مدل ساخته شده‌اند.",
            "battery",
          ],
          [
            "02",
            "انتقال حرکت",
            "چرخ‌دنده، زنجیر، پدال، محور و ترمز دیسکی را از نزدیک ببینید.",
            "drive",
          ],
          [
            "03",
            "کنترل مسیر",
            "فرمان، دسته‌ها، اهرم ترمز و چراغ را بررسی کنید.",
            "cockpit",
          ],
        ].map(([n, t, s, c]) => (
          <button data-velo-detail={c}>
            <span>{n}</span>
            <div>
              <h3>{t}</h3>
              <p>{s}</p>
            </div>
            <b>↗</b>
          </button>
        ))}
      </div>
    </section>
    <section class="wrap section velo-compare-cta">
      <h2>هر مدل، یک شیوهٔ حرکت.</h2>
      <p>CITY، STEP و TOUR در ساختار فریم و تجهیزات تفاوت دارند.</p>
      <a class="button secondary" href={url("demo/velo/compare/")}>
        مقایسهٔ مدل‌ها ↗
      </a>
    </section>
  </main>
  <dialog data-velo-dialog aria-labelledby="velo-summary-title">
    <div class="dialog-head">
      <h2 id="velo-summary-title">انتخاب شما</h2>
      <button class="dialog-close" data-velo-close aria-label="بستن">
        ×
      </button>
    </div>
    <dl class="summary" data-velo-summary-list></dl>
    <p class="notice">
      این پیکربندی محصول مفهومی است. مشخصات مهندسی، قیمت یا سفارش واقعی ارائه
      نمی‌شود.
    </p>
    <button class="button" data-velo-save>
      ذخیرهٔ این انتخاب
    </button>
  </dialog>
  <script>
    import "../../../scripts/velo-v10";
  </script>
</Brand>
