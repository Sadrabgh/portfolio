---
import Aurum from "../../../layouts/Aurum.astro";
import Home from "../../../components/aurum/Home.astro";
import Shop from "../../../components/aurum/Shop.astro";
import Product from "../../../components/aurum/Product.astro";
import Checkout from "../../../components/aurum/Checkout.astro";
import Photo from "../../../components/aurum/Photo.astro";
import Card from "../../../components/aurum/Card.astro";
import Icon from "../../../components/aurum/Icon.astro";
import {
  products,
  collections,
  articles,
  help,
  link,
} from "../../../data/aurum";
export function getStaticPaths() {
  return [
    "",
    "shop",
    ...products.map((p) => "products/" + p.id),
    "collections",
    ...collections.map((c) => "collections/" + c.id),
    "story",
    "journal",
    ...articles.map((a) => "journal/" + a.id),
    "saved",
    "cart",
    "checkout",
    "order",
    "contact",
    ...Object.keys(help).map((k) => "help/" + k),
  ].map((page) => ({ params: { page: page || undefined }, props: { page } }));
}
const { page } = Astro.props;
const product = products.find((p) => "products/" + p.id === page);
const collection = collections.find((c) => "collections/" + c.id === page);
const article = articles.find((a) => "journal/" + a.id === page);
const info = help[page.replace("help/", "")];
const titles: Record<string, string> = {
  "": "Small pieces. Big presence.",
  shop: "The collection",
  collections: "Collections",
  story: "Our story",
  journal: "Journal",
  saved: "Saved pieces",
  cart: "Your bag",
  checkout: "Checkout",
  order: "Your demo order",
  contact: "A little conversation",
};
---

<Aurum
  title={
    product?.name ||
    collection?.name ||
    article?.title ||
    info?.title ||
    titles[page]
  }
  page={page || "home"}
>
  {page === "" && <Home />}
  {page === "shop" && <Shop />}
  {product && <Product product={product} />}
  {page === "checkout" && <Checkout />}
  {page === "collections" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">CURATED, NOT COMPLICATED</span>
        <h1>
          Find your
          <br />
          kind of everyday.
        </h1>
        <p>Three ways into the collection. Make each one your own.</p>
      </div>
      <div class="au-collection-grid">
        {collections.map((c) => (
          <a
            class="au-collection-card"
            href={link("collections/" + c.id + "/")}
          >
            <Photo name={c.image} alt={c.name} />
            <div>
              <h2>{c.name}</h2>
              <Icon />
            </div>
            <p>{c.subtitle}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  {collection && (
    <section class="au-wrap au-content-page">
      <a class="au-text-link" href={link("collections/")}>
        ← All collections
      </a>
      <div class="au-collection-hero">
        <div>
          <span class="au-eyebrow">THE AURUM EDIT</span>
          <h1>{collection.name}</h1>
          <p>{collection.subtitle}</p>
        </div>
        <Photo
          name={collection.image}
          alt={collection.name}
          eager
          sizes="(max-width:700px) 94vw, 55vw"
        />
      </div>
      <div class="au-grid">
        {products
          .filter((p) => collection.ids.includes(p.id))
          .map((p) => (
            <Card product={p} />
          ))}
      </div>
    </section>
  )}
  {page === "story" && (
    <section class="au-story">
      <div class="au-wrap au-page-intro">
        <span class="au-eyebrow">AURUM / OUR POINT OF VIEW</span>
        <h1>
          Small pieces.
          <br />A personal world.
        </h1>
        <p>Good form doesn’t need to be complicated.</p>
      </div>
      <div class="au-editorial">
        <div class="au-editorial-copy">
          <h2>
            Made for
            <br />
            your everyday.
          </h2>
          <span class="au-short-line"></span>
          <p>
            A soft curve, a clear line, a little light. AURUM brings considered
            jewelry into the things you do every day.
          </p>
          <p>
            This independent concept imagines a collection that feels simple to
            choose and personal to wear.
          </p>
        </div>
        <div class="au-editorial-image">
          <Photo
            name="campaign"
            alt="Understated gold hoops and a sage cotton collar"
            eager
            sizes="(max-width:700px) 100vw, 50vw"
          />
        </div>
      </div>
      <div class="au-wrap au-story-notes" data-au-reveal>
        {[
          [
            "Form first.",
            "Clean silhouettes. Soft edges. Space for your own style.",
          ],
          [
            "A closer look.",
            "Product information and size choices stay beside the piece.",
          ],
          [
            "Your everyday.",
            "Start with one favorite and build a collection around you.",
          ],
        ].map(([title, text]) => (
          <div>
            <h2>{title}</h2>
            <p>{text}</p>
          </div>
        ))}
      </div>
      <div class="au-wrap au-story-end">
        <Photo name="hand" alt="A sculptural gold band worn with sage linen" />
        <div>
          <h2>
            A little
            <br />
            brilliance.
          </h2>
          <a class="au-button" href={link("shop/")}>
            Find your piece
            <Icon />
          </a>
        </div>
      </div>
    </section>
  )}
  {page === "journal" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">THE JOURNAL</span>
        <h1>
          Notes for
          <br />
          the everyday.
        </h1>
        <p>A little perspective before choosing your next piece.</p>
      </div>
      <div class="au-journal-grid">
        {articles.map((a) => (
          <a href={link("journal/" + a.id + "/")} class="au-journal-card">
            <Photo name={a.image} alt={a.title} />
            <span class="au-eyebrow">{a.tag}</span>
            <h2>
              {a.title}
              <Icon />
            </h2>
            <p>{a.intro}</p>
          </a>
        ))}
      </div>
    </section>
  )}
  {article && (
    <article class="au-wrap au-article">
      <a class="au-text-link" href={link("journal/")}>
        ← All notes
      </a>
      <div class="au-page-intro">
        <span class="au-eyebrow">{article.tag}</span>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
      </div>
      <Photo
        name={article.image}
        alt={article.title}
        eager
        sizes="(max-width:700px) 94vw, 80vw"
      />
      <div class="au-prose">
        {article.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <a class="au-text-link" href={link("shop/")}>
          Explore the collection
          <Icon />
        </a>
      </div>
    </article>
  )}
  {page === "saved" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">YOUR PERSONAL EDIT</span>
        <h1>
          A little
          <br />
          saved brilliance.
        </h1>
        <p>Keep your favorites close. Return whenever you’re ready.</p>
      </div>
      <div class="au-grid" data-saved-grid>
        {products.map((p) => (
          <Card product={p} saved />
        ))}
      </div>
      <div class="au-empty" data-saved-empty hidden>
        <h2>Start with a favorite.</h2>
        <p>Use the heart on any piece to add it to your edit.</p>
        <a class="au-button" href={link("shop/")}>
          Explore the collection
          <Icon />
        </a>
      </div>
    </section>
  )}
  {page === "cart" && (
    <section class="au-wrap au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">YOUR SELECTION</span>
        <h1>
          Good things,
          <br />
          together.
        </h1>
        <p>A final look before checkout.</p>
      </div>
      <div class="au-cart-layout">
        <div data-bag-lines="page"></div>
        <aside class="au-summary">
          <h2>Your bag.</h2>
          <div class="au-total-row">
            <span>Subtotal</span>
            <strong data-subtotal>$0</strong>
          </div>
          <p>Shipping and gift options at checkout.</p>
          <a class="au-button" href={link("checkout/")} data-checkout-link>
            Continue to checkout
            <Icon />
          </a>
          <a class="au-text-link" href={link("shop/")}>
            Keep exploring
            <Icon />
          </a>
        </aside>
      </div>
    </section>
  )}
  {page === "order" && (
    <section class="au-wrap au-order au-content-page">
      <div class="au-page-intro">
        <span class="au-eyebrow">YOUR DEMO ORDER</span>
        <h1>
          A little
          <br />
          well chosen.
        </h1>
        <p>
          No payment was collected. This receipt is a preview of the complete
          journey.
        </p>
      </div>
      <div data-receipt>
        <h2>No receipt in this session.</h2>
        <p>Start with a piece you love to try the demo checkout.</p>
        <a class="au-button" href={link("shop/")}>
          Explore the collection
          <Icon />
        </a>
      </div>
    </section>
  )}
  {info && (
    <section class="au-wrap au-information">
      <a class="au-text-link" href={link("shop/")}>
        ← Back to the collection
      </a>
      <div class="au-page-intro">
        <span class="au-eyebrow">A LITTLE HELP</span>
        <h1>{info.title}</h1>
        <p>{info.intro}</p>
      </div>
      <div class="au-info-sections">
        {info.sections.map(([heading, text]) => (
          <section>
            <h2>{heading}</h2>
            <p>{text}</p>
          </section>
        ))}
      </div>
      <a class="au-button" href={link("contact/")}>
        Start a conversation
        <Icon />
      </a>
    </section>
  )}
  {page === "contact" && (
    <section class="au-wrap au-contact">
      <div class="au-page-intro">
        <span class="au-eyebrow">A LITTLE CONVERSATION</span>
        <h1>
          Let’s talk
          <br />
          about your piece.
        </h1>
        <p>A size, a detail, an idea. Start here.</p>
        <a class="au-text-link" href={link("help/size-guide/")}>
          Explore the size guide
          <Icon />
        </a>
      </div>
      <form data-contact-form>
        <fieldset disabled data-client-enable>
          <legend>Your message</legend>
          <label>
            Your name
            <input
              name="name"
              required
              maxlength="80"
              placeholder="Alex Example"
            />
          </label>
          <label>
            Email
            <input
              name="email"
              type="email"
              required
              maxlength="120"
              placeholder="alex@example.com"
            />
          </label>
          <label>
            What’s on your mind?
            <textarea
              name="message"
              required
              rows="5"
              maxlength="1000"
              placeholder="Tell us a little…"
            ></textarea>
          </label>
          <p class="au-note">Demo form: your message is not sent or stored.</p>
          <button class="au-button">
            Preview your request
            <Icon />
          </button>
        </fieldset>
        <p data-contact-feedback class="au-form-feedback" role="status"></p>
      </form>
    </section>
  )}
</Aurum>
