---
import { products, categories } from "../../data/aurum";
import Card from "./Card.astro";
import Guides from "./Guides.astro";
import { collections, link } from "../../data/aurum";
import Icon from "./Icon.astro";
---

<section class="au-wrap au-page-intro">
  <span class="au-eyebrow">مجموعهٔ آوروم</span>
  <h1>
    کمی
    <br />
    درخشش تازه.
  </h1>
  <p>فرم‌هایی انتخاب‌شده، برای لحظه‌های روزمره.</p>
</section>
<section class="au-wrap au-catalog" data-catalog>
  <form class="au-filter" role="search">
    <label class="au-search-field">
      <Icon name="search" />
      <span class="au-sr">جست‌وجوی محصولات</span>
      <input
        type="search"
        name="q"
        placeholder="قطعهٔ دلخواهتان را پیدا کنید…"
        autocomplete="off"
      />
    </label>
    <label>
      دسته‌بندی
      <select name="category">
        <option value="all">همهٔ زیورآلات</option>
        {categories.map((c) => (
          <option value={c.id}>{c.name}</option>
        ))}
      </select>
    </label>
    <label>
      مرتب‌سازی
      <select name="sort">
        <option value="featured">منتخب مجموعه</option>
        <option value="price-low">قیمت: کم به زیاد</option>
        <option value="price-high">قیمت: زیاد به کم</option>
        <option value="name">نام</option>
      </select>
    </label>
    <button class="au-text-link" type="button" data-reset-filter>
      پاک کردن فیلترها
    </button>
  </form>
  <div class="au-result-row">
    <p data-result-count role="status" aria-live="polite">
      ۶ محصول
    </p>
    <span>فرم‌های طلایی · مجموعهٔ روزمره</span>
  </div>
  <div class="au-grid" data-product-grid>
    {products.map((p) => (
      <Card product={p} />
    ))}
  </div>
  <div class="au-empty" data-empty-filter hidden>
    <h2>انتخاب دیگری را جست‌وجو می‌کنید؟</h2>
    <p>نام دیگری را امتحان کنید یا تمام مجموعه را ببینید.</p>
    <button class="au-button" data-reset-filter>
      نمایش همهٔ محصولات
      <Icon />
    </button>
  </div>
</section>

<section class="au-wrap au-home-section">
  <div class="au-section-head">
    <h2>با کالکشن‌ها شروع کنید.</h2>
  </div>
  <div class="au-collection-grid">
    {collections.map((c) => (
      <a class="au-collection-card" href={link("collections/" + c.id + "/")}>
        <h3>{c.name}</h3>
        <p>{c.description}</p>
        <span class="au-text-link">
          دیدن کالکشن <Icon />
        </span>
      </a>
    ))}
  </div>
</section>
<Guides />
