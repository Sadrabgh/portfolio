---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { url } from "../config";
const services = [
  [
    "grid", "طراحی سایت فروشگاهی",
    "دسته‌بندی، صفحهٔ محصول و مسیر خرید؛ با ظاهری هماهنگ با برند فروشگاه شما.", "02",
  ],
  [
    "code", "طراحی و بازطراحی سایت",
    "ساخت یک سایت تازه یا بهبود سایت فعلی، با ساختار روشن و نسخهٔ مناسب موبایل و دسکتاپ.", "01",
  ],
  [
    "layers", "نمایش تعاملی محصول",
    "امکان بررسی محصول از زاویه‌های مختلف و دیدن تغییر رنگ یا مدل در همان صفحه.", "03",
  ],
  [
    "motion", "موشن و انیمیشن",
    "تعویض روان تصاویر، باز و بسته‌شدن پنل‌ها و بازخورد واضح برای انتخاب‌های مشتری.", "04",
  ],
];
const approach = [
  ["یک", "شناخت فروشگاه", "محصولات، مخاطب، هدف سایت و امکانات موردنیاز را مشخص می‌کنیم. محدودهٔ پروژه بر اساس همین نیازها شکل می‌گیرد."],
  ["دو", "ساختار و مسیر خرید", "دسته‌بندی‌ها، صفحه‌های اصلی و مسیر انتخاب تا خرید را می‌چینیم تا مشتری اطلاعات موردنیازش را راحت پیدا کند."],
  ["سه", "طراحی صفحه‌ها", "رنگ، تایپوگرافی، تصاویر و اجزای رابط را هماهنگ با برند طراحی می‌کنیم. نسخهٔ موبایل از همین مرحله در نظر گرفته می‌شود."],
  ["چهار", "اجرا و تحویل", "طرح پیاده‌سازی می‌شود؛ لینک‌ها، فرم‌ها و تعامل‌ها بررسی می‌شوند و پس از اصلاح جزئیات، سایت برای انتشار آماده می‌شود."],
];
---

<Base title="خدمات طراحی">
  <section class="services-lead container">
    <div class="services-title" data-motion-reveal>
      <h1>
        خدمات
        <br />
        استودیو
      </h1>
      <p>
        از معرفی محصولات تا صفحهٔ خرید، سایت فروشگاهتان را با توجه به برند و
        نیاز مشتری طراحی می‌کنم. ساخت سایت تازه، بازطراحی سایت فعلی و بهبود
        جزئیات تعامل بخشی از این خدمات‌اند.
      </p>
    </div>
    <div class="service-menu">
      {services.map(([icon, t, d, preset], i) => (
        <a
          href={url("contact/?service=" + preset)}
          data-motion-reveal
          data-delay={i * 100}
        >
          <Icon name={icon} size={60} />
          <h2>{t}</h2>
          <p>{d}</p>
          <Icon name="right" size={40} />
        </a>
      ))}
    </div>
  </section>
  <section class="approach-section container" id="approach">
    <h2 class="sans-section-title" data-motion-reveal>
      مراحل انجام پروژه
    </h2>
    <div class="approach-list">
      {approach.map(([n, t, d], i) => (
        <article data-motion-reveal data-delay={i * 100}>
          <span>{n}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="service-inquiry container" data-motion-reveal>
    <p>برای فروشگاه شما چه امکاناتی لازم است؟</p>
    <a class="text-link" href={url("contact/")}>
      دربارهٔ سایتتان بگویید ↗
    </a>
  </section>
</Base>
