---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { url } from "../config";
const services = [
  [
    "grid",
    "طراحی رابط و تجربهٔ کاربر",
    "ساختار، چیدمان و مسیرهایی که استفاده از سایت را روشن و خوشایند می‌کنند.",
    "01",
  ],
  [
    "code",
    "توسعهٔ وب‌سایت",
    "طراحی اختصاصی در قالب یک وب‌سایت سریع، واکنش‌گرا و قابل استفاده.",
    "01",
  ],
  [
    "layers",
    "تجربهٔ سه‌بعدی",
    "ارائهٔ محصول و ایده در یک محیط تعاملی، قابل بررسی با ماوس و لمس.",
    "03",
  ],
  [
    "motion",
    "حرکت و انیمیشن",
    "حرکت‌هایی که به رابط شخصیت می‌دهند و تغییر وضعیت‌ها را پیوسته می‌کنند.",
    "04",
  ],
];
const approach = [
  [
    "یک",
    "شناخت",
    "هدف، مخاطب و مسیر اصلی سایت روشن می‌شوند. محتوا و نیازهای پروژه، ساختار صفحه‌ها و تصمیم‌های اولیه را شکل می‌دهند.",
  ],
  [
    "دو",
    "ایده",
    "جهت بصری، ترکیب تصاویر، تایپوگرافی و شخصیت حرکت انتخاب می‌شوند. نمونهٔ اولیه، تصمیم‌ها را قابل بررسی می‌کند.",
  ],
  [
    "سه",
    "طراحی",
    "صفحه‌ها و وضعیت‌های رابط در کنار هم طراحی می‌شوند. نسخهٔ موبایل، جزئیات تعامل و دسترسی بخشی از همین مرحله‌اند.",
  ],
  [
    "چهار",
    "توسعه",
    "طرح به یک تجربهٔ قابل استفاده تبدیل می‌شود. حرکت‌ها، مسیرها و اندازه‌های مختلف بررسی می‌شوند و نسخهٔ نهایی آمادهٔ تحویل است.",
  ],
];
---

<Base title="خدمات طراحی">
  <section class="services-lead container">
    <div class="services-title" data-motion-reveal>
      <h1>
        خدمات
        <br />
        استودیو
      </h1>
      <p>
        به کسب‌وکار شما کمک می‌کنم با طراحی دقیق و یک تجربهٔ روشن، بهتر دیده شود
        و ارتباط مؤثرتری با مخاطبش بسازد.
      </p>
    </div>
    <div class="service-menu">
      {services.map(([icon, t, d, preset], i) => (
        <a
          href={url("contact/?service=" + preset)}
          data-motion-reveal
          data-delay={i * 100}
        >
          <Icon name={icon} size={60} />
          <h2>{t}</h2>
          <p>{d}</p>
          <Icon name="right" size={40} />
        </a>
      ))}
    </div>
  </section>
  <section class="approach-section container" id="approach">
    <h2 class="sans-section-title" data-motion-reveal>
      رویکرد ما
    </h2>
    <div class="approach-list">
      {approach.map(([n, t, d], i) => (
        <article data-motion-reveal data-delay={i * 100}>
          <span>{n}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="service-inquiry container" data-motion-reveal>
    <p>از یک صفحهٔ مستقل تا یک تجربهٔ کامل.</p>
    <a class="text-link" href={url("contact/")}>
      دربارهٔ پروژه‌تان بگویید ↗
    </a>
  </section>
</Base>
