---
import Base from "../layouts/Base.astro";
import StudioPortrait from "../components/StudioPortrait.astro";
import Expertise from "../components/Expertise.astro";
import Experience from "../components/Experience.astro";
import PortfolioTile from "../components/PortfolioTile.astro";
import ProjectQuotes from "../components/ProjectQuotes.astro";
import MediaStrip from "../components/MediaStrip.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { site, url } from "../config";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const benefits = [
  { label: ["از پیدا کردن محصول", "تا ثبت سفارش"], value: "خرید آسان" },
  { label: ["ظاهر یکدست", "هماهنگ با فروشگاهتان"], value: "هویت برند" },
  { label: ["انتخاب و خرید راحت", "با گوشی و تبلت"], value: "روی موبایل" },
  { label: ["امکانات و مراحل کار", "مشخص پیش از شروع"], value: "روند شفاف" },
];
---

<Base title="طراحی سایت فروشگاهی و وب‌سایت اختصاصی">
  <section class="freelancer-intro container">
    <h1 data-motion-reveal>
      <span>طراحی سایت فروشگاهی</span>
      <span>برای برند شما،</span>
      <span>با تجربهٔ خرید آسان.</span>
    </h1>
  </section>
  <section class="freelancer-profile container" aria-label="معرفی خدمات طراحی سایت">
    <div class="profile-notes">
      <div data-motion-reveal data-delay="100">
        <span class="eyebrow">دربارهٔ کار من</span>
        <p>
          برای فروشگاه شما، سایتی هماهنگ با برندتان طراحی می‌کنم؛ با معرفی روشن
          محصولات، خرید ساده و تجربه‌ای روان روی موبایل و دسکتاپ.
        </p>
      </div>
      <div data-motion-reveal data-delay="200">
        <span class="eyebrow">تماس</span>
        <a class="profile-contact" href={url("contact/")}>
          دربارهٔ فروشگاهتان بگویید
          <br />
          شروع پروژه
        </a>
        {site.email && (
          <a href={"mailto:" + site.email} dir="ltr">
            {site.email}
          </a>
        )}
      </div>
      <div data-motion-reveal data-delay="300">
        <span class="eyebrow">خدمات</span>
        <ul>
          <li>
            <a href={url("services/")}>طراحی فروشگاه آنلاین</a>
          </li>
          <li>
            <a href={url("services/")}>طراحی و بازطراحی سایت</a>
          </li>
          <li>
            <a href={url("services/")}>موشن و تعامل</a>
          </li>
        </ul>
      </div>
    </div>
    <StudioPortrait
      priority
      src="portfolio/moonex/portrait-linen-color-v6.png"
      alt="پرترهٔ رنگی با پیراهن لینن دکمه‌بسته و ژست نشسته، در قاب بیضی"
      caption="استودیو طراحی"
    />
    <div class="profile-numbers" role="list" aria-label="مزیت‌های سایت برای فروشگاه شما">
      {benefits.map(({ label, value }, i) => (
        <div role="listitem" data-motion-reveal data-delay={i * 100}>
          <span class="eyebrow">
            {label[0]}<br />{label[1]}
          </span>
          <strong class="profile-benefit">{value}</strong>
        </div>
      ))}
    </div>
  </section>
  <div class="project-wordmarks container" aria-label="برندهای نمونه‌کارها">
    {[
      ["form", "ATELIER NO"],
      ["luma", "RIFT"],
      ["orbit", "VELO"],
      ["medical", "NEVA"],
      ["velia", "ALBA"],
      ["rava", "RAVA"],
      ["avan", "AVAN"],
      ["mora", "MORA"],
      ["", "STUDIO"],
    ].map(([id, t], i) => (
      <a
        class={"wordmark wordmark-" + i}
        href={id ? url("work/" + id + "/") : url("about/")}
        dir="ltr"
        data-motion-reveal
        data-delay={i * 100}
      >
        {t}
      </a>
    ))}
  </div>
  <Expertise />
  <Experience />
  <section class="selected-section container" id="selected">
    <h2 class="serif-section-title" data-motion-reveal>
      نمونه‌کارهای منتخب
    </h2>
    <div
      class="carousel project-carousel"
      data-carousel
      data-carousel-kind="projects"
      role="region"
      aria-label="پروژه‌های منتخب"
      tabindex="0"
      data-motion-reveal
    >
      <div class="carousel-viewport">
        <div class="carousel-track">
          {projects.map((p) => (
            <PortfolioTile project={p} slider />
          ))}
        </div>
      </div>
      <div class="carousel-controls" data-carousel-controls hidden>
        <button type="button" data-carousel-prev aria-label="پروژهٔ قبلی">
          <Icon name="right" size={36} />
        </button>
        <button type="button" data-carousel-next aria-label="پروژهٔ بعدی">
          <Icon name="right" size={36} />
        </button>
      </div>
      <span
        class="sr-only"
        data-carousel-status
        role="status"
        aria-live="polite"
      ></span>
    </div>
  </section>
  <ProjectQuotes />
  <MediaStrip />
  <ContactCTA />
</Base>
