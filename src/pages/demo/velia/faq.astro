---
import Velia from "../../../layouts/Velia.astro";
import SkinIcon from "../../../components/velia/SkinIcon.astro";
import { url } from "../../../config";
const groups = [
  [
    "خرید و انتخاب",
    [
      [
        "چطور محصول مناسب را پیدا کنم؟",
        "از دسته‌بندی و فیلتر بافت یا نوع پوست در اطلاعات محصول شروع کن. صفحهٔ محصول، حجم و توضیحات انتخاب را یک‌جا نشان می‌دهد.",
      ],
      [
        "می‌توانم یک روتین را جداگانه سفارش بدهم؟",
        "بله؛ صفحهٔ هر مجموعه، محصولات را جدا نشان می‌دهد و می‌توانی یک محصول یا تمام مجموعه را به سبد اضافه کنی.",
      ],
      [
        "محصول ناموجود چه می‌شود؟",
        "دکمهٔ خرید غیرفعال است و می‌توانی از بخش محصولات مرتبط یک انتخاب دیگر را ببینی.",
      ],
    ],
  ],
  [
    "سبد و سفارش",
    [
      [
        "کد تخفیف چطور اعمال می‌شود؟",
        "در سبد، کد ALBA10 را وارد کن تا ده درصد تخفیف نمایشی روی مبلغ محصولات اعمال شود.",
      ],
      [
        "ارسال رایگان از چه مبلغی است؟",
        "برای جمع محصولات از ۱٬۲۰۰٬۰۰۰ تومان به بالا ارسال استاندارد رایگان نمایش داده می‌شود.",
      ],
      [
        "این فروشگاه سفارش واقعی می‌گیرد؟",
        "این یک نمونه‌کار کامل از تجربهٔ فروشگاه است. پرداخت، احراز هویت و تحویل واقعی انجام نمی‌شود.",
      ],
    ],
  ],
  [
    "حساب و اطلاعات",
    [
      [
        "چطور حساب کاربری را ببینم؟",
        "از صفحهٔ حساب، وارد پیش‌نمایش حساب نمونه شو. سفارش‌ها، نشانی‌ها و تنظیمات با اطلاعات ساختگی قابل بررسی‌اند.",
      ],
      [
        "اطلاعات فرم‌ها ذخیره می‌شوند؟",
        "اطلاعات گیرنده و متن پیام فرم‌ها ذخیره یا به شبکه ارسال نمی‌شوند. سبد و رسید آزمایشی بدون اطلاعات هویتی در مرورگر نگهداری می‌شوند.",
      ],
    ],
  ],
];
---

<Velia title="پرسش‌های متداول" current="help">
  <main id="skin-main" class="skin-wrap">
    <div class="skin-page-heading velia-page-intro">
      <span class="skin-eyebrow" dir="ltr">
        GOOD QUESTIONS, CLEAR ANSWERS
      </span>
      <h1>از ما بپرس.</h1>
      <p>پاسخ پرسش‌های رایج، پیش از انتخاب و پس از سفارش.</p>
    </div>
    <div class="velia-faq-layout">
      <aside class="velia-panel">
        <SkinIcon name="mail" size={36} />
        <h2>پاسخت اینجا نیست؟</h2>
        <p>مسیر تماس و پشتیبانی همیشه در دسترس توست.</p>
        <a class="skin-button" href={url("demo/velia/contact/")}>
          تماس با ما <SkinIcon name="arrow" size={18} />
        </a>
      </aside>
      <div>
        {groups.map(([heading, items]) => (
          <section class="skin-faq velia-faq-group">
            <h2>{heading as string}</h2>
            {(items as string[][]).map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </section>
        ))}
      </div>
    </div>
  </main>
</Velia>
