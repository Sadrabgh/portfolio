---
import {garments, sizes, garmentStock, money, garmentImage} from "../data/brands";
import {url} from "../config";
import Icon from "./Icon.astro";
const look = garments.filter(p=>["shell","cargo"].includes(p.id));
---
<section class="rift-lookbook wrap section" aria-labelledby="look-title" data-lookbook data-motion-scene>
  <div class="section-head"><div><span class="eyebrow">LOOK 01 / BUILT FOR THE CITY</span><h2 id="look-title">این ترکیب را بساز.</h2></div><span class="look-edition" dir="ltr">SHELL + UTILITY</span></div>
  <div class="look-layout">
    <figure class="look-photo"><img src={url("art/v10/campaign.webp")} alt="ترکیب پیشنهادی ژاکت شِل مشکی با شلوار کارگو گرافیتی" width="1536" height="1024" loading="lazy"/>
      {look.map((p,i)=><button class={`look-pin pin-${i}`} data-quick-view={p.id} disabled aria-label={`بررسی سریع ${p.name}`}><span>0{i+1}</span><b>{p.name}</b><Icon name="plus" size={16}/></button>)}
      <figcaption><span dir="ltr">CITY UNIFORM / 01</span><span>برش آزاد، ساختار کاربردی.</span></figcaption>
    </figure>
    <div class="look-builder"><p class="look-intro">یک لایه برای حرکت؛ یک فرم برای هر روز. رنگ و اندازهٔ هر دو را انتخاب کن.</p>
      {look.map((p,i)=><article class="look-item" data-look-item={p.id}>
        <div class="look-item-head"><img data-look-image src={url(garmentImage(p.id,p.colors[0].id))} alt={p.name} width="1024" height="1536" loading="lazy"/><div><span class="eyebrow" dir="ltr">0{i+1} / {p.en}</span><h3><a href={url(`demo/rift/products/${p.id}/`)}>{p.name} ↗</a></h3><span>{money(p.price)}</span></div></div>
        <fieldset><legend>رنگ <span data-look-color-label>{p.colors[0].label}</span></legend><div class="look-colors">{p.colors.map((c,i)=><button type="button" data-look-color={c.id} aria-label={c.label} aria-pressed={i===0} style={`--swatch:${c.hex}`}><span></span>{c.label}</button>)}</div></fieldset>
        <fieldset><legend>اندازه <span class="muted">/ انتخاب کن</span></legend><div class="look-sizes" dir="ltr">{sizes.map(s=><button type="button" data-look-size={s} disabled={!garmentStock[p.id][s]} aria-pressed="false" aria-label={`${s}${!garmentStock[p.id][s]?" · ناموجود":""}`}>{s}</button>)}</div></fieldset>
      </article>)}
      <div class="look-total"><span>مجموع دو محصول</span><strong>{money(look.reduce((n,p)=>n+p.price,0))}</strong></div>
      <button class="button" data-look-add disabled>افزودن ترکیب به سبد <Icon name="bag" size={18}/></button>
      <p class="status" data-look-status role="status">برای افزودن، اندازهٔ هر دو محصول را انتخاب کن.</p>
      <a class="text-link" href={url("demo/rift/size-guide/")}>کدام اندازه مناسب من است؟ <Icon name="arrow" size={16}/></a>
    </div>
  </div>
</section>
