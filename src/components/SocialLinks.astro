---
const { round = false } = Astro.props;
const social = [
  [
    "twitter",
    "https://twitter.com/",
    "توییتر",
    "M22 5.8a8 8 0 0 1-2.4.7 4.1 4.1 0 0 0 1.8-2.3 8.3 8.3 0 0 1-2.6 1 4.1 4.1 0 0 0-7 3.7A11.6 11.6 0 0 1 3.4 4.6a4.1 4.1 0 0 0 1.3 5.5A4 4 0 0 1 2.8 9.6a4.1 4.1 0 0 0 3.3 4 4.1 4.1 0 0 1-1.9.1 4.1 4.1 0 0 0 3.8 2.9A8.3 8.3 0 0 1 2 18.3a11.7 11.7 0 0 0 18-9.8V8a8.3 8.3 0 0 0 2-2.2Z",
  ],
  [
    "facebook",
    "https://www.facebook.com/",
    "فیسبوک",
    "M14.8 22v-9.1h3l.5-3.5h-3.5V7.1c0-1 .3-1.7 1.7-1.7H18V2.3a20 20 0 0 0-2.6-.2c-2.6 0-4.4 1.6-4.4 4.6v2.7H8v3.5h3V22Z",
  ],
  ["instagram", "https://www.instagram.com/", "اینستاگرام", ""],
  [
    "pinterest",
    "https://www.pinterest.com/",
    "پینترست",
    "M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.1-1.9 0-2.8l1.3-5.6s-.3-.6-.3-1.4c0-1.3.8-2.3 1.8-2.3.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.7-4-4.1-4-2.8 0-4.5 2.1-4.5 4.3 0 .9.3 1.8.7 2.3l-.3 1c0 .2-.2.3-.4.2-1.3-.6-2.1-2.3-2.1-3.7 0-3.1 2.3-5.9 6.7-5.9 3.5 0 6.2 2.5 6.2 5.7 0 3.4-2.2 6.2-5.2 6.2-1 0-2-.6-2.3-1.2l-.7 2.7c-.3 1-1 2.1-1.5 2.9A10 10 0 1 0 12 2Z",
  ],
  ["dribbble", "https://dribbble.com/", "دریبل", ""],
];
---

<div
  class:list={["social-links", { "social-links-round": round }]}
  aria-label="شبکه‌های اجتماعی"
>
  {social.map(([key, href, label, path]) => (
    <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        {path ? (
          <path d={path} fill="currentColor" />
        ) : key === "instagram" ? (
          <g fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r=".8" fill="currentColor" />
          </g>
        ) : (
          <g fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="9" />
            <path d="M6 5q6 7 9 15M3 11q9 0 15-7M5 18q5-8 16-4" />
          </g>
        )}
      </svg>
    </a>
  ))}
</div>
