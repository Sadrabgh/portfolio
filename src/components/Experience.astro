---
import { url } from "../config";
const groups = [
  {
    number: "۰۱", label: "شناخت", title: "محصول و مشتری شما",
    description: "نوع محصولات، نیاز مشتری و مسیر انتخاب تا خرید را مشخص می‌کنیم تا ساختار سایت با کار فروشگاه شما هماهنگ باشد.",
    points: ["دسته‌بندی و اولویت صفحه‌ها", "مسیر جست‌وجو، انتخاب و خرید"], href: "services/#approach",
  },
  {
    number: "۰۲", label: "طراحی", title: "ظاهر هماهنگ با برند",
    description: "رنگ‌ها، نوشته‌ها و تصاویر کنار هم طراحی می‌شوند؛ با صفحه‌های محصولی که اطلاعات لازم را واضح نشان می‌دهند.",
    points: ["هویت بصری یکدست", "صفحه‌های محصول و سبد خرید"], href: "work/",
  },
  {
    number: "۰۳", label: "اجرا", title: "بررسی تا آخرین جزئیات",
    description: "طرح پیاده‌سازی می‌شود و صفحه‌ها، فرم‌ها و تعامل‌ها روی موبایل و دسکتاپ بررسی می‌شوند تا نسخهٔ نهایی آمادهٔ استفاده باشد.",
    points: ["نسخهٔ قابل بررسی پیش از تحویل", "اصلاح جزئیات و آماده‌سازی انتشار"], href: "services/#approach",
  },
];
---

<section class="experience-section container">
  <h2 class="serif-section-title" data-motion-reveal>
    از شناخت فروشگاه تا اجرای سایت
  </h2>
  <div class="experience-columns">
    {groups.map((group, i) => (
      <div data-motion-reveal data-delay={i * 100}>
        <span class="eyebrow">{group.number} / {group.label}</span>
        <a class="experience-entry" href={url(group.href)}>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ul>{group.points.map(point => <li>{point}</li>)}</ul>
        </a>
      </div>
    ))}
  </div>
</section>
