---
import Brand from "../../../layouts/Brand.astro";
import { url } from "../../../config";
---

<Brand brand="atelier" title="روش کار و خدمات" current="services">
  <main id="demo-main" class="wrap section">
    <span class="eyebrow">SCOPE & PROCESS</span>
    <h1>
      از صورت مسئله
      <br />
      تا جزئیات فضا.
    </h1>
    <p class="large-copy">
      دامنهٔ همکاری با نیاز پروژه تعریف می‌شود. این مسیر، روش مفهومی آتلیه را
      نشان می‌دهد.
    </p>
    <div class="service-rows">
      {[
        [
          "01",
          "تعریف مسئله",
          "شناخت نیاز، زمینه و محدودیت‌ها",
          "گفت‌وگوی اولیه · برنامهٔ فضایی · اولویت‌ها",
        ],
        [
          "02",
          "طراحی مفهومی",
          "آزمودن روابط حجم، نور و حرکت",
          "دیاگرام · مطالعهٔ حجم · گزینه‌های اولیه",
        ],
        [
          "03",
          "توسعهٔ فضا",
          "ادامهٔ ایده در ماده و جزئیات",
          "پالت مصالح · سازمان فضایی · بازبینی",
        ],
      ].map(([n, t, s, d]) => (
        <article data-reveal>
          <span>{n}</span>
          <h2>{t}</h2>
          <div>
            <h3>{s}</h3>
            <p>{d}</p>
          </div>
        </article>
      ))}
    </div>
    <section class="section two-col">
      <div>
        <h2>پیش از شروع چه می‌پرسیم؟</h2>
        <p>کاربری، متراژ، موقعیت و انتظارات شما تصویر اولیه را می‌سازند.</p>
      </div>
      <div>
        <details>
          <summary>برای گفت‌وگوی اولیه چه اطلاعاتی لازم است؟</summary>
          <p>
            شرح کوتاه نیاز و اندازهٔ حدودی فضا کافی است. اطلاعات تکمیلی در مسیر
            بررسی مشخص می‌شوند.
          </p>
        </details>
        <details>
          <summary>آیا این صفحه خدمات واقعی ارائه می‌دهد؟</summary>
          <p>
            این یک نمونهٔ طراحی است؛ فرم، درخواست واقعی ارسال نمی‌کند و قرارداد
            یا قیمت واقعی ارائه نمی‌شود.
          </p>
        </details>
        <a class="button" href={url("demo/atelier/inquiry/")}>
          تعریف پروژه ↗
        </a>
      </div>
    </section>
  </main>
</Brand>
