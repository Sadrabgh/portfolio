---
import { site, url } from "../config";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
const { compact = false } = Astro.props;
---

<footer class:list={["site-footer", { "compact-footer": compact }]}>
  {!compact && (
    <div class="footer-main container">
      <div class="footer-pitch" data-motion-reveal>
        <h2>
          برای فروشگاه شما،
          <br />
          یک سایت هماهنگ با برندتان.
        </h2>
        <h2>
          شروع با <a href={url("contact/")}>یک گفت‌وگو</a>
        </h2>
        <p>طراحی و اجرای سایت فروشگاهی، از ساختار تا جزئیات تعامل</p>
        <a
          class="footer-contact"
          href={site.email ? "mailto:" + site.email : url("contact/")}
        >
          {site.email || "دربارهٔ سایتتان بگویید."}
        </a>
      </div>
      <div class="footer-links" data-motion-reveal data-delay="100">
        <h3>همکاری</h3>
        <a href={url("services/")}>خدمات</a>
        <a href={url("services/#approach")}>روند انجام کار</a>
        <a href={url("contact/")}>شروع پروژه</a>
        <a href={url("privacy/")}>حریم خصوصی</a>
      </div>
      <div class="footer-links" data-motion-reveal data-delay="200">
        <h3>نمونه‌های فروشگاهی</h3>
        <a href={url("work/")}>نمونه‌کارها</a>
        <a href={url("about/")}>درباره</a>
        <a href={url("demo/mora/")}>مبلمان مورا</a>
        <a href={url("demo/avan/")}>محصولات صوتی آوان</a>
        <a href={url("demo/rava/")}>کفش راوا</a>
        <a href={url("demo/velia/")}>مراقبت پوست آلبا</a>
        <a href={url("demo/rift/")}>پوشاک ریفت</a>
      </div>
    </div>
  )}
  <div class="footer-bottom container">
    {compact ? (
      <a class="footer-brand" href={url()}>
        استودیو طراحی
      </a>
    ) : (
      <a class="footer-brand" href={url()} aria-label="خانه">
        <Logo horizontal />
      </a>
    )}
    <p>© {new Date().getFullYear()} استودیو طراحی. پروژه‌های مستقل و نمایشی.</p>
    {compact ? (
      <a href={url("contact/")} class="footer-bottom-contact">
        شروع گفت‌وگو ↗
      </a>
    ) : (
      <SocialLinks />
    )}
  </div>
  <div class="footer-preferences container">
    <ThemeToggle />
    <button
      class="motion-toggle"
      data-motion-toggle
      type="button"
      aria-pressed="false"
    >
      <span class="motion-switch" aria-hidden="true"></span>کاهش حرکت
    </button>
    <a href="#top" class="back-top">
      بازگشت به بالا ↑
    </a>
  </div>
</footer>
