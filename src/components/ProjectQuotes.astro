---
const quotes = [
  [
    "مشتری باید بتواند محصول مناسب را پیدا کند، مشخصاتش را ببیند و بداند قدم بعدی خرید چیست.",
    "انتخاب آسان", "از جست‌وجو تا سبد خرید",
  ],
  [
    "رنگ‌ها، تصاویر و صفحه‌های فروشگاه باید همان برندی را نشان دهند که مشتری می‌شناسد.",
    "هویت یکدست", "هماهنگی ظاهر سایت با برند",
  ],
  [
    "موشن خوب، نتیجهٔ انتخاب را نشان می‌دهد؛ از تغییر تصویر محصول تا بازشدن سبد خرید، بدون معطل‌کردن مشتری.",
    "تعامل روان", "بازخورد روشن در هر مرحله",
  ],
];
---

<section class="quote-section container" data-motion-reveal>
  <div
    class="carousel quote-carousel"
    data-carousel
    data-carousel-kind="quotes"
    role="region"
    aria-label="یادداشت‌های طراحی"
    tabindex="0"
  >
    <div class="carousel-viewport">
      <div class="carousel-track">
        {quotes.map(([text, name, role]) => (
          <figure class="quote-slide">
            <blockquote>{text}</blockquote>
            <figcaption>
              <strong>{name}</strong>
              <span>{role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="carousel-dots" hidden data-carousel-dots>
      {quotes.map((_, i) => (
        <button
          type="button"
          data-carousel-dot={i}
          aria-label={"یادداشت طراحی " + (i + 1)}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          <span></span>
        </button>
      ))}
    </div>
    <span
      class="sr-only"
      data-carousel-status
      role="status"
      aria-live="polite"
    ></span>
  </div>
</section>
